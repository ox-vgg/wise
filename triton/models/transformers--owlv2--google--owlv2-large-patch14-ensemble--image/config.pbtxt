name: "transformers--owlv2--google--owlv2-large-patch14-ensemble--image"
backend: "python"
max_batch_size: 16

input [
    {
        name: "images"
        data_type: TYPE_FP32
        dims: [ 3, 1008, 1008 ]
    }
]

output [
    {
        name: "embeddings"
        data_type: TYPE_FP32
        dims: [ -1, -1 ]
    },
    {
        name: "scores"
        data_type: TYPE_FP32
        dims: [ -1 ]
    },
    {
        name: "boxes"
        data_type: TYPE_FP32
        dims: [ -1, 4 ]
    }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

parameters: {
  key: "EXECUTION_ENV_PATH",
  value: {string_value: "/wise-env/"}
}
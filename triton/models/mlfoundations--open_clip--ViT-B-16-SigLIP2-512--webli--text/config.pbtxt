name: "mlfoundations--open_clip--ViT-B-16-SigLIP2-512--webli--text"
backend: "python"
max_batch_size: 16

input [
    {
        name: "input_ids"
        data_type: TYPE_INT64
        dims: [ -1 ]
    }
]

output [
    {
        name: "embeddings"
        data_type: TYPE_FP32
        dims: [ -1 ]
    }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

parameters: {
  key: "EXECUTION_ENV_PATH",
  value: {string_value: "/wise-env/"}
}

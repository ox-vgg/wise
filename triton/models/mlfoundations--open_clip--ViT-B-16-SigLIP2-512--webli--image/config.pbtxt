name: "mlfoundations--open_clip--ViT-B-16-SigLIP2-512--webli--image"
backend: "python"
max_batch_size: 16

input [
    {
        name: "images"
        data_type: TYPE_FP32
        dims: [ 3, 512, 512 ]
    }
]

output [
    {
        name: "embeddings"
        data_type: TYPE_FP32
        dims: [ -1 ]
    }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

parameters: {
  key: "EXECUTION_ENV_PATH",
  value: {string_value: "/wise-env/"}
}

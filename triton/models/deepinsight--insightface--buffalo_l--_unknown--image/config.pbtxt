name: "deepinsight--insightface--buffalo_l--_unknown--image"
backend: "python"
max_batch_size: 0

input [
    {
        name: "image"
        data_type: TYPE_UINT8
        dims: [ -1, -1, 3 ]
    }
]

output [
    {
        name: "embeddings"
        data_type: TYPE_FP32
        dims: [ -1, -1 ]
    },
    {
        name: "scores"
        data_type: TYPE_FP32
        dims: [ -1 ]
    },
    {
        name: "boxes"
        data_type: TYPE_FP32
        dims: [ -1, 4 ]
    },
    {
        name: "age"
        data_type: TYPE_INT32
        dims: [ -1 ]
    },
    {
        name: "is_male"
        data_type: TYPE_BOOL
        dims: [ -1 ]
    }
]

parameters: {
  key: "EXECUTION_ENV_PATH",
  value: {string_value: "/wise-env/"}
}

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

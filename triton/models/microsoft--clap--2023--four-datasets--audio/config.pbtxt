name: "microsoft--clap--2023--four-datasets--audio"
backend: "python"
max_batch_size: 0

input [
  {
    name: "audio"
    data_type: TYPE_FP32
    dims: [ 1, 192000 ]
  }
]
output [
  {
    name: "embeddings"
    data_type: TYPE_FP32
    dims: [ 1, -1 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

parameters: {
  key: "EXECUTION_ENV_PATH",
  value: {string_value: "/wise-env/"}
}